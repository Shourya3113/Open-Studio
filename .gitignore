# .gitignore for Open Studio

# OS Metadata
.DS_Store
Thumbs.db
desktop.ini

# Python / Scripts
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# Rust / Cargo
target/
Cargo.lock
**/*.rs.bk

# Node / Frontend
node_modules/
dist/
build/
.next/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tauri v2
src-tauri/target/

# Local Environment & Secrets
.env
.env*.local
*.pem
*.key

# Open Studio Runtime Checkpoints & Local Indices
.openstudio/
.ai-checkpoints/
*.sqlite
*.sqlite-wal
*.sqlite-shm
